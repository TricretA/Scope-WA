{
  "manifest_version": 3,
  "name": "WA Contact Extractor — Export WhatsApp group members",
  "version": "1.0.0",
  "description": "Pull the member list of any WhatsApp group you're in and export names + numbers to CSV, Excel, VCF, TXT or JSON, with filters (exclude me/admins/saved contacts) and cross-group dedupe.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WA Contact Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/wa-store.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
