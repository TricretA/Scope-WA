{
  "manifest_version": 3,
  "name": "WA Group Adder — Bulk add contacts to a WhatsApp group",
  "version": "1.0.0",
  "description": "Add contacts from CSV/VCF/TXT to a WhatsApp group in bulk, with group picker, status-coded results and conservative anti-ban pacing.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WA Group Adder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/wa-store.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
